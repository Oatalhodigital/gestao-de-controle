generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  plan          String    @default("free")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  categories    Category[]
  incomes       Income[]
  expenses      Expense[]
  creditCards   CreditCard[]
  tuitions      TuitionPayment[]
  goals         Goal[]
  bankroll      BettingBankroll?
  modules       UserModule[]

  @@map("users")
}

model Category {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  type      String
  color     String?

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes   Income[]
  expenses  Expense[]

  @@index([userId])
  @@map("categories")
}

model Income {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  categoryId  String?   @map("category_id")
  description String?
  amount      Decimal   @db.Decimal(12, 2)
  date        DateTime  @db.Date
  recurring   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@map("incomes")
}

model Expense {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  categoryId    String?   @map("category_id")
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       DateTime? @map("due_date") @db.Date
  paid          Boolean   @default(false)
  paymentMethod String?   @map("payment_method")
  recurring     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, dueDate])
  @@map("expenses")
}

model CreditCard {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String?
  limitAmount   Decimal?  @map("limit_amount") @db.Decimal(12, 2)
  closingDay    Int?      @map("closing_day")
  dueDay        Int?      @map("due_day")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  CreditCardTransaction[]

  @@index([userId])
  @@map("credit_cards")
}

model CreditCardTransaction {
  id            String    @id @default(uuid())
  cardId        String    @map("card_id")
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  installments  Int       @default(1)
  date          DateTime  @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  card          CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, date])
  @@map("credit_card_transactions")
}

model TuitionPayment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  institution   String?
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       DateTime  @map("due_date") @db.Date
  paid          Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@map("tuition_payments")
}

model Goal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  module        String?
  targetAmount  Decimal   @map("target_amount") @db.Decimal(12, 2)
  period        String?
  startDate     DateTime? @map("start_date") @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@map("goals")
}

model BettingBankroll {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  initialCapital  Decimal   @map("initial_capital") @db.Decimal(12, 2)
  currentBalance  Decimal   @map("current_balance") @db.Decimal(12, 2)
  dailyGoal       Decimal   @map("daily_goal") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         BettingEntry[]

  @@index([userId])
  @@map("betting_bankroll")
}

model BettingEntry {
  id            String    @id @default(uuid())
  bankrollId    String    @map("bankroll_id")
  date          DateTime  @db.Date
  stakeAmount   Decimal   @map("stake_amount") @db.Decimal(12, 2)
  resultAmount  Decimal   @map("result_amount") @db.Decimal(12, 2)
  profit        Decimal   @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  bankroll      BettingBankroll @relation(fields: [bankrollId], references: [id], onDelete: Cascade)

  @@index([bankrollId, date])
  @@map("betting_entries")
}

model Module {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  userModules UserModule[]

  @@map("modules")
}

model UserModule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  active    Boolean  @default(true)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("user_modules")
}
